{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/core.md\""
          },
          {
            "type": "command",
            "command": "find . -maxdepth 3 -name '*.kicad_pro' -print -quit | grep -q . && cat \"${CLAUDE_PLUGIN_ROOT}/rules/hardware.md\" || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/tools/comment_lint.py\" --hook"
          }
        ]
      }
    ]
  }
}
